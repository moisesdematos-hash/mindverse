# ==============================================================================
# MINDVERSE — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# IMPORTANTE:
# - As variáveis com prefixo VITE_ são expostas ao browser no frontend.
# - NUNCA adicione chaves secretas de IA ou service role com prefixo VITE_.
# - Chaves privadas devem ser configuradas exclusivamente nas Supabase Edge
#   Functions (`supabase secrets set`) e no painel da Vercel (Production/Preview).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENTE FRONTEND (Vite / Browser)
# ------------------------------------------------------------------------------
VITE_APP_NAME="MINDVERSE"
VITE_APP_URL="http://localhost:5173"
VITE_DEFAULT_LOCALE="pt"

# Supabase (Configuração Pública do Cliente)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica-aqui"

# ------------------------------------------------------------------------------
# 2. BACKEND / SERVERLESS / EDGE FUNCTIONS (Acesso Seguro - Servidor Apenas)
# ------------------------------------------------------------------------------
# Supabase Service Role (Apenas para tarefas administrativas/migrações de backend)
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-aqui"

# ------------------------------------------------------------------------------
# 3. FORNECEDORES DE INTELIGÊNCIA ARTIFICIAL (Backend / Edge Functions Apenas)
# ------------------------------------------------------------------------------
# OpenAI (Utilizado para embeddings text-embedding-3-small e modelos GPT-4o)
OPENAI_API_KEY="sk-proj-..."

# Anthropic (Utilizado para raciocínio profundo com Claude 3.5 Sonnet)
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini (Alternativa de alto contexto com Gemini 1.5 Pro / Flash)
GEMINI_API_KEY="AIzaSy..."

# Groq (Utilizado para inferência de altíssima velocidade e debates em tempo real)
GROQ_API_KEY="gsk_..."

# ------------------------------------------------------------------------------
# 4. CONFIGURAÇÃO DE MODELOS E LIMITES (Backend)
# ------------------------------------------------------------------------------
DEFAULT_SOLO_MODEL="claude-3-5-sonnet"
DEFAULT_DEBATE_MODEL="groq-llama-3.3-70b"
DEFAULT_EMBEDDING_MODEL="text-embedding-3-small"
DAILY_FREE_TOKEN_QUOTA="30000"

# ------------------------------------------------------------------------------
# 5. MONITORIZAÇÃO E OBSERVABILIDADE (Opcional em Desenvolvimento)
# ------------------------------------------------------------------------------
SENTRY_DSN=""
